# LifelineGrid backend configuration (copy to .env for local overrides)

LIFELINE_ENV=local
LIFELINE_TIME_SCALE=60
LIFELINE_ADMIN_ENABLED=true
LIFELINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LIFELINE_JWT_SECRET=change-me-in-production
LIFELINE_JWT_ALGORITHM=HS256
LIFELINE_JWT_EXPIRE_MINUTES=480

# External services (optional -- engines fall back to synthetic/offline data
# when these are unset or unreachable)
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEMINI_API_KEY=
SARVAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
